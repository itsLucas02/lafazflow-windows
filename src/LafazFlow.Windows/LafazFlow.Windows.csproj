<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\Icons\LafazFlow.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <Target Name="CaptureGitCommit" BeforeTargets="GenerateAssemblyInfo">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="LafazFlowGitCommit" />
    </Exec>
    <PropertyGroup>
      <InformationalVersion Condition="'$(LafazFlowGitCommit)' != ''">$(Version)+$(LafazFlowGitCommit)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Sounds\esc.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Sounds\pastess.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Sounds\recstart.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Sounds\recstop.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
